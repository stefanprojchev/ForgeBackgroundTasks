---
import { resolveHref, isNavGroup } from "../config";
import type { NavEntry, NavItem } from "../config";

interface Props {
  items: NavEntry[];
  section: string;
}

const { items, section } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "");

function isActive(item: NavItem) {
  return currentPath === resolveHref(item.href).replace(/\/$/, "");
}
---

<aside class="hidden w-52 shrink-0 lg:block">
  <nav class="sticky top-20">
    <h3 class="mb-3 font-mono text-[11px] font-medium uppercase tracking-widest text-muted-foreground">{section}</h3>
    <ul class="space-y-0.5">
      {items.map((entry) => {
        if (isNavGroup(entry)) {
          const groupActive = entry.children.some(isActive);
          return (
            <li>
              <span
                class:list={[
                  "block px-3 pt-3 pb-1 text-[11px] font-medium uppercase tracking-wider",
                  groupActive ? "text-amber-400" : "text-muted-foreground",
                ]}
              >
                {entry.title}
              </span>
              <ul class="space-y-0.5">
                {entry.children.map((child) => {
                  const active = isActive(child);
                  return (
                    <li>
                      <a
                        href={resolveHref(child.href)}
                        class:list={[
                          "relative block rounded-md pl-5 pr-3 py-1.5 text-[13px] transition-all",
                          active
                            ? "bg-amber-400/10 font-medium text-amber-400"
                            : "text-muted-foreground hover:bg-accent hover:text-foreground",
                        ]}
                      >
                        {active && <span class="absolute left-1.5 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-amber-400" />}
                        {child.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        }

        const active = isActive(entry as NavItem);
        return (
          <li>
            <a
              href={resolveHref((entry as NavItem).href)}
              class:list={[
                "relative block rounded-md px-3 py-1.5 text-[13px] transition-all",
                active
                  ? "bg-amber-400/10 font-medium text-amber-400"
                  : "text-muted-foreground hover:bg-accent hover:text-foreground",
              ]}
            >
              {active && <span class="absolute left-0 top-1/2 h-4 w-0.5 -translate-y-1/2 rounded-full bg-amber-400" />}
              {(entry as NavItem).title}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>
