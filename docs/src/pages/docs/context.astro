---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PageNavigation from "../../components/PageNavigation.astro";

const structDef = `public struct BackgroundTaskContext: Sendable {
    /// Returns true when the system has asked the task to stop.
    public let isCancelled: @Sendable () -> Bool

    /// Network connectivity status at the time the task started.
    public let connectivity: ConnectivityStatus

    /// Whether protected data (Keychain, CoreData) is accessible.
    public let protectedDataAvailable: Bool
}`;

const cancellationExample = `func execute(context: BackgroundTaskContext) async {
    let records = await database.pendingRecords()

    for record in records {
        if context.isCancelled() { return }
        await upload(record)
    }
}`;

const connectivityExample = `func execute(context: BackgroundTaskContext) async {
    // Check connectivity from context — no need for a separate observer
    guard context.connectivity.isConnected else {
        // Task will be rescheduled automatically
        return
    }

    if context.connectivity.isExpensive {
        // On cellular — send only critical items
        await uploadCriticalItems()
    } else {
        await uploadAll()
    }
}`;

const protectedDataExample = `func execute(context: BackgroundTaskContext) async {
    guard context.protectedDataAvailable else {
        // Device is locked — skip work that needs Keychain access
        return
    }

    let token = try? keychain.read("auth-token")
    // ...
}`;
---

<DocsLayout title="BackgroundTaskContext" section="docs">
  <h1>BackgroundTaskContext</h1>
  <p class="text-lg text-muted-foreground mt-1 mb-8">Runtime context passed to <code>execute(context:)</code>. Provides cancellation, connectivity, and protected data state.</p>

  <h2>Struct</h2>
  <CodeBlock code={structDef} title="BackgroundTaskContext.swift" />

  <h2>isCancelled</h2>
  <p><code>isCancelled</code> is a closure that returns <code>true</code> when the system has revoked the task's background time. The registry sets this when the <code>BGTask.expirationHandler</code> fires. Call it periodically inside loops — not just once at the top.</p>
  <CodeBlock code={cancellationExample} title="Checking cancellation" />

  <h2>connectivity</h2>
  <p>A snapshot of <code>ConnectivityStatus</code> captured when the task launched. Use it to gate network work without needing to inject a separate observer into your task.</p>
  <CodeBlock code={connectivityExample} title="Using connectivity" />

  <h2>protectedDataAvailable</h2>
  <p>Reflects whether the device's protected data (Keychain, encrypted CoreData stores, files with <code>NSFileProtectionComplete</code>) is accessible. This is <code>false</code> when the device is locked. The registry also performs this check automatically when <code>requiresProtectedData</code> is <code>true</code> — skip the task before even calling <code>execute</code>.</p>
  <CodeBlock code={protectedDataExample} title="Checking protected data" />

  <PageNavigation
    prevHref="docs/schedule"
    prevLabel="BackgroundTaskSchedule"
    nextHref="docs/registry"
    nextLabel="BackgroundTaskRegistry"
  />
</DocsLayout>
