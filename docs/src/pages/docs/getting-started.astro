---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PageNavigation from "../../components/PageNavigation.astro";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "../../components/starwind/tabs";

const spmDeps = `dependencies: [
    .package(url: "https://github.com/stefanprojchev/ForgeBackgroundTasks.git", from: "1.0.0")
]`;

const spmTarget = `targets: [
    .target(
        name: "YourApp",
        dependencies: ["ForgeBackgroundTasks"]
    )
]`;

const cliCommand = `swift package add-dependency https://github.com/stefanprojchev/ForgeBackgroundTasks.git --from 1.0.0`;

const infoPlist = `<!-- Info.plist -->
<key>BGTaskSchedulerPermittedIdentifiers</key>
<array>
    <string>com.taskflow.sync</string>
    <string>com.taskflow.cleanup</string>
</array>`;

const appDelegateSetup = `import UIKit
import ForgeBackgroundTasks
import ForgeObservers

@main
class AppDelegate: UIResponder, UIApplicationDelegate {

    let registry = BackgroundTaskRegistry(
        connectivity: ConnectivityObserver(),
        protectedData: ProtectedDataObserver()
    )

    func application(
        _ application: UIApplication,
        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?
    ) -> Bool {
        registry.register(SyncTask())
        registry.registerWithSystem()
        return true
    }
}`;

const scheduleOnBackground = `func sceneDidEnterBackground(_ scene: UIScene) {
    (UIApplication.shared.delegate as? AppDelegate)?.registry.scheduleAll()
}`;

const simulatorDebug = `e -l objc -- (void)[[BGTaskScheduler sharedScheduler] _simulateLaunchForTaskWithIdentifier:@"com.taskflow.sync"]`;
---

<DocsLayout title="Getting Started" section="docs">
  <h1>Getting Started</h1>
  <p class="text-lg text-muted-foreground mt-1 mb-8">Install ForgeBackgroundTasks, declare your tasks, register with the system, and schedule on background entry.</p>

  <h2>Requirements</h2>
  <ul>
    <li>iOS 18+</li>
    <li>Swift 6.3+ (Xcode 26 or later)</li>
  </ul>

  <h2>Installation</h2>

  <Tabs defaultValue="xcode" syncKey="install" class="not-prose my-6">
    <TabsList>
      <TabsTrigger value="xcode">Xcode UI</TabsTrigger>
      <TabsTrigger value="package-swift">Package.swift</TabsTrigger>
      <TabsTrigger value="cli">Swift CLI</TabsTrigger>
    </TabsList>
    <TabsContent value="xcode">
      <div class="mt-4 space-y-2 text-[15px] text-foreground">
        <ol class="list-decimal space-y-1.5 pl-5">
          <li>Open your project in Xcode.</li>
          <li>Go to <strong>File &rarr; Add Package Dependencies&hellip;</strong></li>
          <li>Paste the repository URL: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[13px]">https://github.com/stefanprojchev/ForgeBackgroundTasks.git</code></li>
          <li>Set the version rule to <strong>Up to Next Major</strong> from <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[13px]">1.0.0</code>.</li>
          <li>Select your app target and click <strong>Add Package</strong>.</li>
        </ol>
      </div>
    </TabsContent>
    <TabsContent value="package-swift">
      <CodeBlock code={spmDeps} title="Package.swift -- dependencies" />
      <CodeBlock code={spmTarget} title="Package.swift -- target" />
    </TabsContent>
    <TabsContent value="cli">
      <CodeBlock code={cliCommand} lang="bash" title="Terminal" />
    </TabsContent>
  </Tabs>

  <h2>Info.plist</h2>
  <p>Every task identifier must be declared in <code>BGTaskSchedulerPermittedIdentifiers</code> before it can be registered with the system.</p>
  <CodeBlock code={infoPlist} lang="xml" title="Info.plist" />

  <h2>AppDelegate Setup</h2>
  <p>Create a <code>BackgroundTaskRegistry</code>, register your tasks, then call <code>registerWithSystem()</code> during <code>didFinishLaunchingWithOptions</code>. Registration must happen before the app finishes launching.</p>
  <CodeBlock code={appDelegateSetup} title="AppDelegate.swift" />

  <h2>Schedule on Background Entry</h2>
  <p>Call <code>scheduleAll()</code> whenever the app enters the background so the system knows to wake it up again. The <code>sceneDidEnterBackground</code> scene delegate callback is the right place.</p>
  <CodeBlock code={scheduleOnBackground} title="SceneDelegate.swift" />

  <h2>Debugging in Simulator</h2>
  <p>Use the Xcode debugger to simulate a background task launch without waiting for the system to trigger it.</p>
  <CodeBlock code={simulatorDebug} lang="bash" title="Xcode Debugger (lldb)" />

  <div class="not-prose my-4 rounded-lg border border-amber-500/20 bg-amber-500/5 p-4">
    <p class="text-[13px] text-amber-200"><strong>Simulator tip</strong> — pause execution in the debugger after launch, run the <code class="rounded bg-amber-500/10 px-1 py-0.5 text-[12px]">e -l objc</code> command above, then resume. The task handler fires immediately.</p>
  </div>

  <PageNavigation
    nextHref="docs/background-task"
    nextLabel="BackgroundTask Protocol"
  />
</DocsLayout>
