---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PageNavigation from "../../components/PageNavigation.astro";

const enumDef = `public enum BackgroundTaskSchedule: Sendable {
    /// Short-lived app refresh task (~30 seconds).
    /// - Parameter interval: Minimum seconds between executions. nil means ASAP.
    case refresh(interval: TimeInterval? = nil)

    /// Long-running processing task (minutes). Requires power.
    case processing(
        requiresNetwork: Bool = false,
        requiresCharging: Bool = false,
        interval: TimeInterval? = nil
    )

    /// The minimum interval between executions, if set.
    public var interval: TimeInterval? { ... }
}`;

const refreshExample = `struct SyncTask: BackgroundTask {
    // Run at most once per hour
    let schedule = BackgroundTaskSchedule.refresh(interval: 3600)
    // ...
}

struct CheckTask: BackgroundTask {
    // Run as soon as possible
    let schedule = BackgroundTaskSchedule.refresh()
    // ...
}`;

const processingExample = `struct DatabaseCleanupTask: BackgroundTask {
    let schedule = BackgroundTaskSchedule.processing(
        requiresNetwork: false,
        requiresCharging: true,   // run only while charging
        interval: 86400            // at most once per day
    )
    // ...
}

struct FullSyncTask: BackgroundTask {
    let schedule = BackgroundTaskSchedule.processing(
        requiresNetwork: true,
        requiresCharging: false,
        interval: 43200            // at most twice per day
    )
    // ...
}`;
---

<DocsLayout title="BackgroundTaskSchedule" section="docs">
  <h1>BackgroundTaskSchedule</h1>
  <p class="text-lg text-muted-foreground mt-1 mb-8">Determines whether to use <code>BGAppRefreshTaskRequest</code> or <code>BGProcessingTaskRequest</code>, and how often to run.</p>

  <h2>Enum</h2>
  <CodeBlock code={enumDef} title="BackgroundTaskSchedule.swift" />

  <div class="not-prose my-4 rounded-lg border border-amber-500/20 bg-amber-500/5 p-4">
    <p class="text-[13px] text-amber-200"><strong>System discretion</strong> — <code class="rounded bg-amber-500/10 px-1 py-0.5 text-[12px]">interval</code> is a <em>minimum</em>. The system decides actual timing based on battery, usage patterns, and other factors. The app has no guarantee of exact timing.</p>
  </div>

  <h2>Refresh</h2>
  <p>Use <code>.refresh</code> for short, time-sensitive work — cache updates, badge counts, lightweight syncs. The system grants approximately 30 seconds of CPU time.</p>
  <CodeBlock code={refreshExample} title="Refresh examples" />

  <h2>Processing</h2>
  <p>Use <code>.processing</code> for longer operations — database migrations, full syncs, media processing. The system waits for conditions to be favorable (e.g., charging, idle) before launching.</p>
  <CodeBlock code={processingExample} title="Processing examples" />

  <h2>Comparison</h2>

  <div class="not-prose my-6 overflow-x-auto">
    <table class="w-full text-[13px]">
      <thead>
        <tr class="border-b border-border/60">
          <th class="py-2 pr-4 text-left font-medium text-muted-foreground">Case</th>
          <th class="py-2 pr-4 text-left font-medium text-muted-foreground">BGTask type</th>
          <th class="py-2 pr-4 text-left font-medium text-muted-foreground">Time budget</th>
          <th class="py-2 text-left font-medium text-muted-foreground">Use for</th>
        </tr>
      </thead>
      <tbody class="text-foreground">
        <tr class="border-b border-border/30">
          <td class="py-2 pr-4 font-mono text-amber-400">.refresh</td>
          <td class="py-2 pr-4 font-mono">BGAppRefreshTaskRequest</td>
          <td class="py-2 pr-4">~30 seconds</td>
          <td class="py-2">Lightweight, frequent updates</td>
        </tr>
        <tr>
          <td class="py-2 pr-4 font-mono text-amber-400">.processing</td>
          <td class="py-2 pr-4 font-mono">BGProcessingTaskRequest</td>
          <td class="py-2 pr-4">Minutes</td>
          <td class="py-2">Heavy work, runs when charging/idle</td>
        </tr>
      </tbody>
    </table>
  </div>

  <PageNavigation
    prevHref="docs/background-task"
    prevLabel="BackgroundTask Protocol"
    nextHref="docs/context"
    nextLabel="BackgroundTaskContext"
  />
</DocsLayout>
